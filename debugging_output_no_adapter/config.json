  "tie_word_embeddings": false,
  "torch_dtype": "float32",
  "transformers_version": "4.37.2",
  "us_sparse_regularization": true,
  "use_cache": true,
  "use_graceful_regularization": true,
  "use_relu": false,
  "use_sparse_model": true,
  "use_sparse_predictor": false,
  "use_sparse_regularization": false,
  "vocab_size": 32000
