{
  "architectures": [
    "SparseMistralforCausalLM"
  ],
  "attention_dropout": 0.0,
  "auto_map": {
    "AutoConfig": "sparsification_sftt.SparseMistralConfig",
    "AutoModelForCausalLM": "sparsification_sftt.SparseMistralforCausalLM"
